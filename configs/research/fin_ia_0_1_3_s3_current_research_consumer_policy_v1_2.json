      "company_authored_unaudited_sec_filing",
      "official_hosted_management_call_transcript"
    ],
    "earnings_call_transcript_constraints": {
      "required_source_tier": "official_hosted_management_call_transcript",
      "reviewed_pack_only": true,
      "open_retrieval_source_type_expansion": false,
      "automatic_numeric_fact_promotion": false
    }
  },
  "cell_contracts": [
    {
      "cell_id": "CELL::demand_quality",
      "title_zh": "需求真实性与持续性",
      "primary_slot_id": "demand_volume_quality",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 4
    },
    {
      "cell_id": "CELL::operating_performance",
      "title_zh": "经营表现与增量规模",
      "primary_slot_id": "operating_performance",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 12
    },
    {
      "cell_id": "CELL::value_capture",
      "title_zh": "价值与利润获取",
      "primary_slot_id": "pricing_mix_value_capture",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 8
    },
    {
      "cell_id": "CELL::cash_conversion",
      "title_zh": "现金转换与资产负债表",
      "primary_slot_id": "cash_conversion_balance_sheet",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 10
    },
    {
      "cell_id": "CELL::counterevidence",
      "title_zh": "反方证据与判断改变条件",
      "primary_slot_id": "counterevidence_and_what_would_change",
      "supplemental_context_slot_ids": ["capacity_inputs_execution"],
      "maximum_evidence_items": 12,
      "maximum_numeric_facts": 6
    }
  ],
  "numeric_fact_selection": {
    "strategy": "latest_period_and_same_basis_comparable_per_metric",
    "maximum_non_instant_periods_per_metric": 2,
    "deduplicate_request_identity": true,
    "preserve_source_request_and_period_role_lineage": true,
    "same_fiscal_period_comparison_required_for_year_over_year_language": true
  },
  "research_context_contract": {
    "role_method_packs": [
      {
        "pack_id": "ROLE_METHOD::VALUE_CAPTURE::V1",
        "cell_id": "CELL::value_capture",
        "role_id": "fundamental_value_capture_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::VC::PERIOD_BASIS",
            "instruction_zh": "只有同一指标、单位、期间角色和同一财季的关系卡才能支持同比、扩张或压缩判断。"
          },
          {
            "method_step_ref": "METHOD::VC::PRODUCT_FINANCIAL_BRIDGE",
            "instruction_zh": "先区分产品收入、分部利润和公司利润，再判断产品增长是否有直接证据桥接到利润获取。"
          },
          {
            "method_step_ref": "METHOD::VC::CAUSAL_BOUNDARY",
            "instruction_zh": "同时发生的收入和利润变化不是因果归因；缺少产品级利润、价格数量组合或成本桥时只能做有界推断。"
          },
          {
            "method_step_ref": "METHOD::VC::COUNTERREAD",
            "instruction_zh": "保留最强替代解释，包括低毛利硬件组合、提前采购、分部内其他业务和未经审计的管理层口径。"
          },
          {
            "method_step_ref": "METHOD::VC::MATERIAL_GAP_ROUTE",
            "instruction_zh": "只为会改变判断且存在可执行来源路线的缺口提交补证；商业数据或行业数据路线不可用时保持 typed gap。"
          },
          {
            "method_step_ref": "METHOD::VC::WHAT_WOULD_CHANGE",
            "instruction_zh": "判断改变条件必须是可观察、可复核且与当前证据缺口直接相关的变量。"
          }
        ]
      }
    ],
    "evidence_request_source_classes": [
