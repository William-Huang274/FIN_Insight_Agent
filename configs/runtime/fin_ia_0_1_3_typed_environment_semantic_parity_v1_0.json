        "cardinality": "exactly_one"
      },
      {
        "root_id": "installed_distribution_roots",
        "role": "installed_distribution_roots",
        "projection_token": "<ENV:INSTALLED_DISTRIBUTION_ROOT>",
        "source": "host_frozen_python_environment.importlib_metadata",
        "cardinality": "one_or_more_sorted_unique"
      }
    ],
    "required_runtime_root_fields": [
      "root_id",
      "role",
      "absolute_path",
      "projection_token",
      "source",
      "digest_or_environment_fingerprint"
    ],
    "derive_native_and_posix_separator_variants_from_exact_roots": true,
    "replace_longest_exact_literal_first": true,
    "substring_or_fuzzy_path_matching_allowed": false,
    "replace_only_exact_or_descendant_paths": true,
    "Windows_drive_letter_case_insensitive": true,
    "unknown_absolute_path_patterns": [
      "(?<![A-Za-z0-9_])[A-Za-z]:[\\\\/][^\\s\\\"'<>]+",
      "(?<![A-Za-z0-9_:>])/(?:[^/\\s\\\"'<>]+/)+[^/\\s\\\"'<>]+"
    ],
    "unknown_absolute_path_behavior": "fail_closed_and_keep_parity_false"
  },
  "semantic_projection": {
    "normalized_content_fields": [
      "test.stdout",
      "test.stderr",
      "test.detail",
      "collection_errors",
      "process_stdout",
      "process_stderr"
