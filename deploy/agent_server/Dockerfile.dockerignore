# Deny the whole repository build context, then admit only the package files
# consumed by deploy/agent_server/Dockerfile. Dockerfile-specific ignore
# rules take precedence over the broader repository .dockerignore.
**
!pyproject.toml
!uv.lock
!README.md
!src/
!src/**/
!src/**/*.py
!src/**/*.sql
!src/sec_agent/research_foundation/methods/*.md
# The source allowlist above must never re-admit interpreter/build residue.
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.pyd
!configs/
!configs/research/
!configs/research/model_routing.json
!configs/research/quick_answer.json
!configs/research/reference_foundation.json
!configs/research/structured_agents.json
!configs/research/cases/
!configs/research/cases/growth_quality.json
!configs/research/runtime/
!configs/research/runtime/research_session.json
!configs/research/runtime/conversation.json
