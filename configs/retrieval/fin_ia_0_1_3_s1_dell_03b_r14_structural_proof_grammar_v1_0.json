      "might",
      "must",
      "shall",
      "should",
      "was",
      "were",
      "will",
      "would"
    ],
    "finite_or_participle_suffixes": [
      "ed",
      "en",
      "es",
      "ing",
      "s"
    ],
    "irregular_finite_forms": [
      "became",
      "began",
      "bought",
      "brought",
      "built",
      "came",
      "did",
      "fell",
      "grew",
      "had",
