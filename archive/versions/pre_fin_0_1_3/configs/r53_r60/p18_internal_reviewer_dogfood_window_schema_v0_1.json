{
  "closeout_level": "L4_scope_pass",
  "endpoints": [
    {
      "description": "Read pilot window status, tiles, cases, sessions, defects and gates.",
      "method": "GET",
      "path": "/api/r53-r60/pilot/dashboard",
      "surface": "pilot_dashboard"
    },
    {
      "description": "List pilot case assignments and reviewer-session state.",
      "method": "GET",
      "path": "/api/r53-r60/pilot/cases",
      "surface": "pilot_case_list"
    },
    {
      "description": "Inspect one pilot case assignment, actions, defects and feedback links.",
      "method": "GET",
      "path": "/api/r53-r60/pilot/cases/{case_id}",
      "surface": "pilot_case_detail"
    }
  ],
  "policy": {
    "defects_must_promote_to_regression_queue_or_typed_gap": true,
    "frontend_dashboard_is_projection_only": true,
