{
  "schema_version": "fin_ia_dell_03B_R14_structural_proof_grammar_v1_0",
  "grammar_id": "FIN-0.1.3-S1-DELL-03B-R14-STRUCTURAL-PROOF-GRAMMAR-V1",
  "parser_id": "conservative_event_proof_v1",
  "span_contract": {
    "coordinate_system": "unicode_code_point",
    "interval": "half_open_start_inclusive_end_exclusive",
    "raw_text_rewritten": false,
    "raw_span_rewritten": false
  },
  "normalization": {
    "proof_form": [
      "NFKC",
      "casefold",
      "frozen_punctuation_class_map"
    ],
    "punctuation_class_map": {
      "‘": "'",
      "’": "'",
      "“": "\"",
      "”": "\"",
      "‐": "-",
      "‑": "-",
      "–": "-",
      "—": "-"
    }
  },
  "proof_states": [
    "PROVED",
    "AMBIGUOUS",
    "UNSUPPORTED",
    "MALFORMED"
  ],
  "tokenizer": {
    "longest_match": true,
    "priority": [
      "MONEY",
      "PERCENT",
      "NUMBER",
      "WORD",
      "PUNCT",
      "WHITESPACE"
    ],
    "word_internal_joiners": [
      "-",
      "'"
    ],
    "word_joiner_requires_word_on_both_sides": true,
    "priority_collision_state": "MALFORMED"
  },
  "scope": {
    "paragraph_boundary": "newline",
    "hard_boundary_surface": [
      ".",
      "?",
      "!",
      ";",
      ":",
      "—"
    ],
    "soft_coordinators": [
      "and",
      "but",
      "or",
      "while",
      "whereas",
      "then",
      "yet"
    ],
    "parenthetical_pairs": [
      "()",
      "[]",
      "{}"
    ],
    "quotation_pairs": [
      "\"\"",
      "''",
      "“”",
      "‘’"
    ],
    "cross_hard_scope_material_edges": "forbidden_unless_target_contract_bridge"
  },
  "structural_resources": {
    "auxiliaries": [
      "am",
      "are",
      "be",
      "been",
      "being",
      "can",
      "could",
      "did",
      "do",
      "does",
      "had",
