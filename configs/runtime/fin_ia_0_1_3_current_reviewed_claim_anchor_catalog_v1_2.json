      "anchor_end": 154,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 0,
      "anchor_text": "Working capital during Fiscal 2025 was primarily impacted by AI dynamics, which led to higher inventory, accounts receivable, and accounts payable levels.",
      "case_key": "DELL",
