      "anchor_end": 253,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 0,
      "anchor_text": "Larger orders may also require greater commitments of working capital, such as for purchases of key components, which could adversely affect our cash flow and expose us to the risk of holding excess and obsolete inventory due to delays or cancellations.",
      "case_key": "DELL",
      "evidence_item_digest": "a8056d9ea1f1ea609ac7b23ec9a51d0ff37ea5bd81b6e33d207c9bcd0f2903d6",
      "review_status": "reviewed_exact_source_surface",
