  "root_cause_disposition": {
    "RC_P36_067": {
      "issue_id": "RC-P36-067-s4-R10-numeric-reference-value-correspondence-false-negative",
      "immediate_model_fault": "the model emitted material numeric statements that contradict the exact Numeric refs named as support",
      "earliest_project_control_fault": "the S4 flat numeric row schema uses numeric_ref value comparison_operator and direct scope fields, while the shared model-view and verifier projection still expect legacy financial_row_id normalized_value and nested selector fields; the exact value-bearing row is reduced to scale_multiplier plus an empty selector",
      "first_provider_fault": "after receiving only opaque Numeric refs without their bound values the model still emits unrestricted numeric-bearing Fact statements instead of preserving cannot-infer",
      "propagation_fault": "FactSupportAuthorityPolicy validates only exact ref membership, and Claim plus Writer free-text surfaces can restate numeric content without a structured numeric projection or local-only rendering owner",
      "verifier_false_negative_fault": "the local verifier authority projection is empty for the S4 numeric refs because financial_row_id is absent; it therefore cannot recompute any rendered value and the validator checks only state machine refs and digests",
      "classification": "L1_project_owned_S4_numeric_schema_adapter_projection_and_deterministic_correspondence_gap_with_confirmed_model_unsupported_precision",
      "model_instruction_noncompliance_established": true,
      "provider_transport_or_network_failure": false
    },
    "RC_P36_068": {
      "issue_id": "RC-P36-068-s4-R10-case-identity-title-contract-hardcoded-NVDA",
      "immediate_fault": "the local memo-writer v3 assembler emits NVDA 三单元内部研究备忘录 for every case",
      "earliest_project_control_fault": "the report delivery identity is not derived from S3ThreeCellBoundedAgentInputPack.company or the S4 case-runtime binding",
      "validator_false_negative_fault": "the local writer validator treats the hard-coded NVDA title as the only valid value, so a DELL title mismatch is positively enforced",
      "classification": "L1_project_owned_case_delivery_identity_projection_gap",
      "model_instruction_noncompliance_established": false,
      "provider_title_generation_in_R10": false
    }
