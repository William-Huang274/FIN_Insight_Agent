{
  "schema_version": "fin_ia_current_research_consumer_policy_v1_3",
  "status": "provider_neutral_reviewed_evidence_numeric_relation_and_context_consumer",
  "reviewed_source_policy": {
    "allowed_source_types": [
      "10-K",
      "10-Q",
      "8-K",
      "20-F",
      "40-F",
      "6-K",
      "EARNINGS_CALL_TRANSCRIPT",
      "PUBLIC_WEB"
    ],
    "allowed_source_tiers": [
      "primary_sec_filing",
      "company_authored_unaudited_sec_filing",
      "official_hosted_management_call_transcript",
      "issuer_regulator_or_government_primary",
      "named_counterparty_or_standards_primary",
      "official_market_or_industry_primary",
      "trusted_media_industry_association_or_public_analyst_context"
    ],
    "earnings_call_transcript_constraints": {
      "required_source_tier": "official_hosted_management_call_transcript",
      "reviewed_pack_only": true,
      "open_retrieval_source_type_expansion": false,
      "automatic_numeric_fact_promotion": false
    },
    "public_web_constraints": {
      "reviewed_pack_only": true,
      "direct_evidence_requires_issuer_regulator_or_government_primary": true,
      "non_issuer_sources_are_bounded_context_only": true,
      "automatic_numeric_fact_promotion": false,
      "target_company_causal_authority": false
    }
  },
  "cell_contracts": [
    {
      "cell_id": "CELL::demand_quality",
      "title_zh": "需求真实性与持续性",
      "primary_slot_id": "demand_volume_quality",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 4,
      "numeric_capacity_contract": {
        "mode": "static_upper_bound"
      }
    },
    {
      "cell_id": "CELL::operating_performance",
      "title_zh": "经营表现与增量规模",
      "primary_slot_id": "operating_performance",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 12,
      "numeric_capacity_contract": {
        "mode": "static_upper_bound"
      }
    },
    {
      "cell_id": "CELL::value_capture",
      "title_zh": "价值与利润获取",
      "primary_slot_id": "pricing_mix_value_capture",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 10,
      "numeric_capacity_contract": {
        "mode": "metric_period_bundle",
        "allowed_metric_ids": [
          "revenue",
          "gross_profit",
          "gross_margin",
          "operating_income",
          "operating_margin"
        ],
        "maximum_periods_per_metric": 2,
        "same_cadence_pair_atomic": true,
        "subject_ticker_only": true
      }
    },
    {
      "cell_id": "CELL::cash_conversion",
      "title_zh": "现金转换与资产负债表",
      "primary_slot_id": "cash_conversion_balance_sheet",
      "supplemental_context_slot_ids": [],
      "maximum_evidence_items": 8,
      "maximum_numeric_facts": 10,
      "numeric_capacity_contract": {
        "mode": "static_upper_bound"
      }
    },
    {
      "cell_id": "CELL::counterevidence",
      "title_zh": "反方证据与判断改变条件",
      "primary_slot_id": "counterevidence_and_what_would_change",
      "supplemental_context_slot_ids": [
        "capacity_inputs_execution"
      ],
      "maximum_evidence_items": 12,
      "maximum_numeric_facts": 6,
      "numeric_capacity_contract": {
        "mode": "static_upper_bound"
      }
    }
  ],
  "numeric_fact_selection": {
    "strategy": "latest_period_and_same_basis_comparable_per_metric",
    "maximum_non_instant_periods_per_metric": 2,
    "deduplicate_request_identity": true,
    "preserve_source_request_and_period_role_lineage": true,
    "same_fiscal_period_comparison_required_for_year_over_year_language": true
  },
  "research_context_contract": {
    "role_method_packs": [
      {
        "pack_id": "ROLE_METHOD::DEMAND_QUALITY::V1",
        "cell_id": "CELL::demand_quality",
        "role_id": "demand_quality_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::DQ::SIGNAL_LADDER",
            "instruction_zh": "区分订单、积压、出货、收入、部署和终端消耗；较早或较弱的需求信号不能自动证明持续转化。"
          },
          {
            "method_step_ref": "METHOD::DQ::OWNER_AND_DIRECTION",
            "instruction_zh": "先确认谁披露、在谈谁以及关系方向；客户或生态方材料只能提供有界 read-through，不能冒充本案公司自述。"
          },
          {
            "method_step_ref": "METHOD::DQ::DURABILITY_TEST",
            "instruction_zh": "同时检查提前采购、消化、取消、集中度、部署节奏和转化缺口；单期高增长或管理层乐观表述不足以证明耐久需求。"
          },
          {
            "method_step_ref": "METHOD::DQ::PERIOD_AND_CONVERSION_BASIS",
            "instruction_zh": "趋势和转化判断必须保持同一指标、期间角色和可比口径；没有同口径关系时只陈述当前信号。"
          },
          {
            "method_step_ref": "METHOD::DQ::MATERIAL_GAP_AND_WWC",
            "instruction_zh": "只追问会改变需求判断的订单、积压转化、部署或消化证据，并把判断改变条件写成可观察的后续披露。"
          }
        ]
      },
      {
        "pack_id": "ROLE_METHOD::OPERATING_PERFORMANCE::V1",
        "cell_id": "CELL::operating_performance",
        "role_id": "operating_performance_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::OP::SCOPE_AND_BASIS",
            "instruction_zh": "先区分公司、分部和产品口径，以及季度、累计和财年口径；只有同指标、同单位、同期间角色的关系卡可支持比较。"
          },
          {
            "method_step_ref": "METHOD::OP::ACTUAL_VS_GUIDANCE",
            "instruction_zh": "把已实现经营结果、管理层指引和长期目标分开，不能用未来目标改写当前实际表现。"
          },
          {
            "method_step_ref": "METHOD::OP::GROWTH_QUALITY",
            "instruction_zh": "同时检查收入规模、利润率、经营利润和业务组合；增长与利润同时变化只证明共现，不能自动归因于单一产品或驱动。"
          },
          {
            "method_step_ref": "METHOD::OP::MIX_AND_ONE_OFF",
            "instruction_zh": "保留产品组合、季节性、一次性项目、会计口径和其他业务贡献等替代解释。"
          },
          {
            "method_step_ref": "METHOD::OP::MATERIAL_GAP_AND_WWC",
            "instruction_zh": "只为会改变经营质量判断的分部或产品桥、利润率口径和后续指引提交补证，并给出可复核的改变条件。"
          }
        ]
      },
      {
        "pack_id": "ROLE_METHOD::VALUE_CAPTURE::V1",
        "cell_id": "CELL::value_capture",
        "role_id": "fundamental_value_capture_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::VC::PERIOD_BASIS",
            "instruction_zh": "只有同一指标、单位、期间角色和同一财季的关系卡才能支持同比、扩张或压缩判断。"
          },
          {
            "method_step_ref": "METHOD::VC::PRODUCT_FINANCIAL_BRIDGE",
            "instruction_zh": "先区分产品收入、分部利润和公司利润，再判断产品增长是否有直接证据桥接到利润获取。"
          },
          {
            "method_step_ref": "METHOD::VC::CAUSAL_BOUNDARY",
            "instruction_zh": "同时发生的收入和利润变化不是因果归因；缺少产品级利润、价格数量组合或成本桥时只能做有界推断。"
          },
          {
            "method_step_ref": "METHOD::VC::COUNTERREAD",
            "instruction_zh": "保留最强替代解释，包括低毛利硬件组合、提前采购、分部内其他业务和未经审计的管理层口径。"
          },
          {
            "method_step_ref": "METHOD::VC::MATERIAL_GAP_ROUTE",
            "instruction_zh": "只为会改变判断且存在可执行来源路线的缺口提交补证；商业数据或行业数据路线不可用时保持 typed gap。"
          },
          {
            "method_step_ref": "METHOD::VC::WHAT_WOULD_CHANGE",
            "instruction_zh": "判断改变条件必须是可观察、可复核且与当前证据缺口直接相关的变量。"
          }
        ]
      },
      {
        "pack_id": "ROLE_METHOD::CASH_CONVERSION::V1",
        "cell_id": "CELL::cash_conversion",
        "role_id": "cash_conversion_balance_sheet_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::CC::CASH_BRIDGE",
            "instruction_zh": "按同一期间把净利润、经营现金流、资本开支和自由现金流分开，再判断利润是否真正转化为现金。"
          },
          {
            "method_step_ref": "METHOD::CC::WORKING_CAPITAL_BASIS",
            "instruction_zh": "存货、应收、应付等时点余额只能描述资产负债表状态；没有流量桥和同口径期间时不能直接断言现金原因。"
          },
          {
            "method_step_ref": "METHOD::CC::PRODUCT_ATTRIBUTION_BOUNDARY",
            "instruction_zh": "公司现金流、营运资金和采购承诺不能自动归因于 AI、某产品或某客户；缺少产品级桥时保持公司口径。"
          },
          {
            "method_step_ref": "METHOD::CC::LIQUIDITY_AND_COMMITMENTS",
            "instruction_zh": "区分经营现金生成、资本投入、采购承诺、融资与流动性；承诺或余额上升本身不等于已发生现金流。"
          },
          {
            "method_step_ref": "METHOD::CC::MATERIAL_GAP_AND_WWC",
            "instruction_zh": "优先追问会改变现金转换判断的营运资金桥、资本开支和产品归因证据，并把改变条件绑定到后续可观察指标。"
          }
        ]
      },
      {
        "pack_id": "ROLE_METHOD::COUNTEREVIDENCE::V1",
        "cell_id": "CELL::counterevidence",
        "role_id": "risk_counterevidence_analyst",
        "minimum_consumed_method_steps": 4,
        "method_steps": [
          {
            "method_step_ref": "METHOD::CE::THESIS_STRESS_TEST",
            "instruction_zh": "先识别前四个研究单元最强的实际判断，再优先寻找足以削弱、反转或限制这些判断的材料，而不是罗列通用风险。"
          },
          {
            "method_step_ref": "METHOD::CE::DIRECTNESS_AND_OWNER",
            "instruction_zh": "区分本案直接反证、相关方 read-through、背景风险和纯证据缺口；供应商或客户材料不能冒充本案事实。"
          },
          {
            "method_step_ref": "METHOD::CE::CONSTRAINT_NOT_RESOLUTION",
            "instruction_zh": "供应扩张、需求增长或风险披露只约束判断；没有分配、时点、良率或本案传导证据时不能宣称瓶颈已经缓解或风险已经实现。"
          },
          {
            "method_step_ref": "METHOD::CE::CONFLICT_DISCIPLINE",
            "instruction_zh": "直接冲突不得平均化或选择更乐观的一边；保留来源、期间和作用域差异，并说明冲突如何限制结论。"
          },
          {
            "method_step_ref": "METHOD::CE::MATERIAL_WWC",
            "instruction_zh": "只保留最重要且可观察的判断改变条件；无法取得权威来源或阈值不可观察时必须保持 typed gap。"
          }
        ]
      }
    ],
