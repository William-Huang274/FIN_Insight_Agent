        "cardinality": "exactly_one"
      },
      {
        "root_id": "disposable_temporary_root",
        "role": "disposable_temporary_parent",
        "projection_token": "<ENV:DISPOSABLE_TEMPORARY_ROOT>",
        "source": "runner.temporary_parent",
        "cardinality": "exactly_one"
      },
      {
        "root_id": "sys_prefix",
        "role": "python_prefix",
        "projection_token": "<ENV:PYTHON_PREFIX>",
        "source": "host_frozen_python_environment.sys_prefix",
        "cardinality": "exactly_one"
      },
      {
        "root_id": "sys_base_prefix",
        "role": "python_base_prefix",
        "projection_token": "<ENV:PYTHON_BASE_PREFIX>",
        "source": "host_frozen_python_environment.sys_base_prefix",
