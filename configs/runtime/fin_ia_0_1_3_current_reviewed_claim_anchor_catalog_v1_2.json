      "anchor_end": 2433,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 2273,
      "anchor_text": "The decreases in gross margin percentage and non-GAAP gross margin percentage were primarily driven by a shift in mix towards our AI-optimized server offerings.",
      "case_key": "DELL",
      "evidence_item_digest": "af11bf4358e167dbf7f1105d981a56a6b568dc92362b2753e2278aaa901294b1",
      "review_status": "reviewed_exact_source_surface",
