  "object_spec_library": {
    "COBJ::c649445947ddfb68fa3cb1fb": {
      "business_meaning_zh": "Microsoft 披露持续投入 AI 基础设施并伴随 AI 产品使用增长，说明下游部署仍在消耗资本与算力资源。",
      "claim_boundary_zh": "只作为下游需求背景；不证明研究主体获得了 Microsoft 的订单、份额或收入。",
      "relationship_directions": ["evidence_owner_own_demand_or_investment", "consumer_case_ecosystem_readthrough_only"]
    },
    "COBJ::32e86517a12652405137a787": {
      "business_meaning_zh": "Microsoft 当前季度成本上升包含为客户需求与 AI 使用而进行的基础设施投入。",
      "claim_boundary_zh": "不把 Microsoft 的投入金额或利润变化归属于研究主体，也不等同其订单量。",
      "relationship_directions": ["evidence_owner_own_demand_or_investment", "consumer_case_ecosystem_readthrough_only"]
    },
    "COBJ::0d0917c0dd2f8846d85842fb": {
      "business_meaning_zh": "Microsoft 当前季度成本上升明确受到支持客户需求的 AI 基础设施投资驱动。",
      "claim_boundary_zh": "仅证明下游投资活动；不证明供应商分配、产品映射或研究主体收入贡献。",
      "relationship_directions": ["evidence_owner_own_demand_or_investment", "consumer_case_ecosystem_readthrough_only"]
    },
    "COBJ::f9c13c79a8c50dd1eeb57394": {
      "business_meaning_zh": "Micron 披露 HBM4 已向领先客户平台大批量出货，并向多个终端客户提供认证样品。",
      "claim_boundary_zh": "未披露领先客户身份、各客户出货量、收入贡献或与 NVIDIA 的直接绑定。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::85f4f169d8566e7c4e5209b4": {
      "business_meaning_zh": "Micron 的战略客户协议采用 take-or-pay，并对多年合同期内的特定数量形成约束。",
      "claim_boundary_zh": "未披露客户身份、数量、产品组合或 backlog；不能把合同承诺直接当收入。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::c27b82b71738dcf287ac514f": {
      "business_meaning_zh": "Micron 披露已签战略客户协议对应现金押金和相关财务承诺。",
      "claim_boundary_zh": "精确金额只能由 S2 NumericFact 绑定引用；该披露不等同订单量、收入或利润。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::4113595bbddedf191029ba24": {
      "business_meaning_zh": "Micron 已启动新加坡 HBM 先进封装设施，计划自 2027 年上半年开始扩充先进封装能力。",
      "claim_boundary_zh": "项目计划不等同当前可用产能；未披露规模、良率、客户分配或爬坡完成度。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::8ce9daeffe417c82615e9857": {
      "business_meaning_zh": "Micron 披露 HBM 相比传统 DRAM 需要更多晶圆和洁净室空间，说明供给扩张具有更高资源强度。",
      "claim_boundary_zh": "这是制造机制，不提供当前利用率、良率、位元产出或客户可用分配。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::bbe786a4c79083a0dc2464e8": {
      "business_meaning_zh": "Micron 将多层 HBM 的良率、质量、堆叠和先进封装列为实际技术壁垒。",
      "claim_boundary_zh": "风险与壁垒披露不证明当前已经发生重大良率损失，也未量化缺口。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::285b39bddd1212c5c28d8ad5": {
      "business_meaning_zh": "Micron 明确提示大客户关系变化或数据中心需求下降会损害业务。",
      "claim_boundary_zh": "不证明风险已经发生，也未披露客户集中度或收入敏感度。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::d00bda426ae5573aea76b94f": {
      "business_meaning_zh": "Micron 说明客户数据中心建设受能源、水、资本和审批等资源约束，延迟可能影响未来业绩。",
      "claim_boundary_zh": "属于需求兑现反方，不量化受影响项目、时间或收入。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::d5b8fada2b8960683ecd1afd": {
      "business_meaning_zh": "Micron 指出 HBM 需求走弱后产能可能回流传统 DRAM，从而形成显著供给增加。",
      "claim_boundary_zh": "这是周期反转机制，不证明当前 HBM 需求已经走弱或供给已回流。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::b040d306c476a706260935e5": {
      "business_meaning_zh": "NVIDIA 当前季度公司及数据中心业务继续高速增长，并明确给出产品与网络方案需求背景。",
      "claim_boundary_zh": "数值权威和同比计算归 S2；叙事不能把全部增长单因归因于某一产品或客户。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::0065ea7ccdb7dc162734bf2f": {
      "business_meaning_zh": "NVIDIA 持续向现有及新增供应商扩大供应与产能采购，以支持需求预测和产品复杂度。",
      "claim_boundary_zh": "未披露供应商、产品级分配、可用产能、良率或释放时点。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::105491ae67a1a5e0c775beb2": {
      "business_meaning_zh": "NVIDIA 为锁定未来供应支付溢价、押金并承担长期产能承诺，这些安排已提高产品成本。",
      "claim_boundary_zh": "未披露供应商、金额和产品归属；不能据此计算利润桥或确定未来可用产能。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::446f4a4bcb2e34a40fd756f6": {
      "business_meaning_zh": "NVIDIA 已签订预付制造和产能协议以支持当前及未来产品。",
      "claim_boundary_zh": "合同存在不等于产能已释放、符合良率或分配给特定产品。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::fd70285573b56aa0930a9188": {
      "business_meaning_zh": "NVIDIA 披露半导体短缺或供应能力受限时，部分供应的交期可能延长。",
      "claim_boundary_zh": "风险披露不证明当前每一产品均延期，也没有量化交期或缺口。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::db735740b6438e6ce6dd3d13": {
      "business_meaning_zh": "NVIDIA 指出长制造周期、供应不确定与需求预测偏差会造成供需错配。",
      "claim_boundary_zh": "未披露当前错配规模、产品层分布或已实现损失。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::8274b77a68bad84f7820827c": {
      "business_meaning_zh": "NVIDIA 明确提示高估需求、客户取消或延后订单会造成库存和采购承诺难以及时收缩。",
      "claim_boundary_zh": "不证明取消已经发生，也未披露取消率、客户集中度或损失金额。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::6bad3b80a28f25e2d0cb3f9a": {
      "business_meaning_zh": "当库存或供应与产能承诺超过需求时，NVIDIA 可能确认存货准备或减值。",
      "claim_boundary_zh": "仅证明下行机制；未证明当前已有由 AI 产品造成的具体减值。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::9b7f2b4641672046d1bcff73": {
      "business_meaning_zh": "NVIDIA 披露新架构和复杂系统上线已造成、未来也可能造成生产延迟和供需管理挑战。",
      "claim_boundary_zh": "未披露受影响产品、延期时长或收入金额。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::a12318a5213895b69196e5ab": {
      "business_meaning_zh": "NVIDIA 客户和合作伙伴的数据中心建设需要可用场地、能源与资本，短缺会影响未来业绩。",
      "claim_boundary_zh": "不证明某一客户项目已经延期，也未量化需求兑现影响。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::72c46d22715a76a9e0da2233": {
      "business_meaning_zh": "NVIDIA 披露截至 FY2027 第一季度末，公司实际上已无法参与中国数据中心计算市场竞争。",
      "claim_boundary_zh": "只证明市场准入与竞争风险；不外推未披露收入或利润损失。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::d7e1d18e750e4343728bc382": {
      "business_meaning_zh": "NVIDIA 说明数据中心 GPU 出口限制还可能削弱相关网络产品需求。",
      "claim_boundary_zh": "属于政策传导风险，未量化网络产品订单、收入或概率。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::ef41f60d880ab175d43e2963": {
      "business_meaning_zh": "NVIDIA 披露自然灾害、疫情等其他供应约束也可能造成交期延长。",
      "claim_boundary_zh": "是补充性供应风险，不证明当前已经发生特定事件或延期。",
      "relationship_directions": ["subject_self_disclosure"]
    },
    "COBJ::bb4b07ecca957f89a598fc06": {
      "business_meaning_zh": "TSMC 管理层确认封装产能非常紧张，并已限制客户增长。",
      "claim_boundary_zh": "只作为行业上游约束；不证明研究主体的供应商身份、分配量或释放时点。",
      "relationship_directions": ["evidence_owner_own_supply_capacity_or_constraint", "consumer_case_ecosystem_readthrough_only"]
    },
    "COBJ::07ef64bd2d61623d1f4d9262": {
      "business_meaning_zh": "TSMC 管理层说明扩产中仍需针对瓶颈设备追加投入。",
      "claim_boundary_zh": "不说明瓶颈与研究主体产品或订单的直接对应关系。",
      "relationship_directions": ["evidence_owner_own_supply_capacity_or_constraint", "consumer_case_ecosystem_readthrough_only"]
    },
    "COBJ::dbe25978af4e48df2d32a099": {
      "business_meaning_zh": "TSMC 管理层说明测试设备短缺，需要在测试与封装等环节增加资本开支。",
      "claim_boundary_zh": "仅证明后端环节约束；不证明研究主体的可用分配或解除时间。",
      "relationship_directions": ["evidence_owner_own_supply_capacity_or_constraint", "consumer_case_ecosystem_readthrough_only"]
    }
  },
