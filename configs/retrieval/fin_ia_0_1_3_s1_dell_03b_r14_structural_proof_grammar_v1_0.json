      "ran",
      "rose",
      "said",
      "sold",
      "took",
      "was",
      "went",
      "were",
      "won",
      "wrote"
    ],
    "subject_pronouns": [
      "he",
      "i",
      "it",
      "she",
      "they",
      "we",
      "you"
    ],
    "function_words": [
      "a",
      "an",
