# Copy to a Git-ignored .env or set these in the process environment.
# Never commit credential values.

# Dell reference vertical: the only product runtime is LangGraph Agent Server,
# and every real run is traced to LangSmith. Put real values only in the
# Git-ignored .env file. `langgraph dev` is a development fixture; the final
# local demo uses the checked-in loopback-only Agent Server Compose stack.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fin-insight-dell-reference-vertical
# Reserved for a future separately approved paid/model gate. The current
# zero-model Compose service does not inject this value into the API container.
DEEPSEEK_API_KEY=
FINSIGHT_AGENT_SERVER_POSTGRES_PASSWORD=
FINSIGHT_AGENT_SERVER_HOST_PORT=18123
FINSIGHT_LANGGRAPH_POSTGRES_PASSWORD=
FINSIGHT_FIN_RUNTIME_POSTGRES_PASSWORD=
FINSIGHT_FIN_RUNTIME_OPERATOR_POSTGRES_PASSWORD=

# Dell Agent Server host-side read-only data bindings. Compose uses these only
# as bind-mount sources; it does not pass the host paths into the container.
# The checked-in defaults below are the exact frozen Dell data-gate artifacts
# on the primary workstation. Override them in the ignored .env when another
# Docker host exposes the same digest-bound files at different paths.
FINSIGHT_DELL_S1_NODES_HOST_PATH=Z:/FIN_Insight_Agent_qualification/dell_reference_vertical/rag_mature_stack/retrieval_qualification/dell_rag_full_stack_preview_attempt_20260902_03/retrieval_nodes.jsonl
FINSIGHT_DELL_REVIEWED_BASE_PACK_HOST_PATH=D:/FIN_Insight_Agent/data/workbench_private/fin_0_1_3_s1_dell_direct_source_evidence/r4/successor/pack.json
FINSIGHT_DELL_REVIEWED_OVERLAY_HOST_PATH=Z:/FIN_Insight_Agent_qualification/dell_reference_vertical/evidence_overlay/attempts/20260902T051005+0800-dell-fy27q2-sec-ex99-review-a01/reviewed-evidence-case-projection.json
FINSIGHT_DELL_S2_RESULT_HOST_PATH=Z:/FIN_Insight_Agent_qualification/dell_reference_vertical/s2/s2_exact_period_contract_successor_20260902_r1/company_financial_fact_mart_result.json
FINSIGHT_DELL_S2_MART_HOST_PATH=Z:/FIN_Insight_Agent_qualification/dell_reference_vertical/s2/s2_exact_period_contract_successor_20260902_r1/company_financial_facts.sqlite
FINSIGHT_DELL_EXTERNAL_PACK_HOST_ROOT=Z:/FIN_Insight_Agent_qualification/dell_reference_vertical/external_exact_url_qualification/dell_external_exact_url_zero_model_20260902_r12

# Explicit private-data boundary. Relative paths resolve from the repository.
FINSIGHT_DATA_ROOT=data
# Immutable reviewed Evidence objects; may be mounted read-only.
FINSIGHT_REVIEWED_EVIDENCE_ROOT=data/workbench_private
# Mutable Operations SQLite and job state; must be a separate writable mount in containers.
FINSIGHT_WORKBENCH_PRIVATE_ROOT=data/workbench_private
FINSIGHT_OBJECT_STORE_ROOT=data/object_store
FINSIGHT_SECONDARY_DATA_ROOTS=

# SEC requires an identifiable contact for automated clients.
SEC_USER_AGENT=FinSight-Agent/0.1.3 contact@example.com

# Optional external-data credentials. Leave blank when the provider is unused.
FMP_API_KEY=
EIA_API_KEY=

# Optional semantic supplement; disabled/unbound in the current baseline.
FINSIGHT_MILVUS_MODE=unbound_cloud_deferred
FINSIGHT_MILVUS_RUNTIME_CONFIG=

# Workbench process limits.
WORKBENCH_MAX_ACTIVE_JOBS=2
WORKBENCH_DEFAULT_TIMEOUT_S=900
WORKBENCH_CANCEL_GRACE_S=5
