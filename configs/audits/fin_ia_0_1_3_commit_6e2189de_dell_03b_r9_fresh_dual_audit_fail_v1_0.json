        "src/retrieval/dell_report_predicate_frames_r9.py:489"
      ],
      "root_cause": "A closed _FRAME_RIGHT_SUBJECT lexical enumeration is required for a coordinator split. An explicit right-side subject outside the enumeration is therefore treated as no independent frame even when both sides have predicates.",
      "reproduction": "Dell quoted support for USD 150 and Acme offered PowerEdge XE9680 hardware for USD 15.",
      "observed": "boundary=no_split; right_subject_span=null; one frame; complete ASP incorrectly combines Dell/quoted with Acme product/price",
      "same_family_reproduction": "Replacing Acme with Supermicro produces the same false complete; replacing it with the reseller splits correctly only because the reseller is enumerated.",
      "required_fix": "Use structural right-prefix plus predicate frame ownership rather than a finite company/entity vocabulary; retain compound/shared-subject controls and fail close on ambiguous coordination."
    },
    {
      "finding_id": "R9-P2-PRODUCT-PRICE-RELATION-OMITTED",
      "severity": "P2",
      "owner_stage": "S1_03B_ASP_argument_relation_and_source_compiled_transformation",
      "code_refs": [
        "src/retrieval/dell_report_predicate_frames_r9.py:1302",
        "src/retrieval/dell_report_predicate_frames_r9.py:1455",
        "src/retrieval/dell_report_predicate_frames_r9.py:1538",
        "src/retrieval/dell_report_predicate_frames_r9.py:1555",
        "src/retrieval/dell_report_predicate_frames_r9.py:1960",
        "src/retrieval/dell_report_frame_transformation_r9.py:147",
        "src/retrieval/dell_report_frame_transformation_r9.py:267"
      ],
      "root_cause": "ASP completion selects a record-global product and a unique hardware-class price without requiring the hardware argument group's product_span. Semantic signatures and transformation mappings preserve role/scope bags but omit the product-to-price argument relation.",
      "source_reproduction": "Dell offered PowerEdge XE9680 hardware for USD 15.",
      "compiled_reproduction": "Dell offered PowerEdge XE9680 and support for USD 100 plus hardware for USD 15.",
      "observed": "Both frames are complete and have equal semantic digests; the compiled USD 15 hardware group has product_span=null; transformation is accepted with zero loss/addition/ambiguity.",
      "required_fix": "Derive both accepted product and price from one unique unambiguous hardware argument group with a non-null product span, include the normalized product-price relation in the semantic signature, and map that relation across source and compiled frames."
    }
  ],
