{
  "schema_version": "fin_ia_0_1_3_material_numeric_program_policy_v1_1",
  "contract_ref": "fin_0_1_3.S1.material_numeric_program_formula_and_typed_gap:v1.1",
  "purpose": "Govern every current-as-of material numeric value with latest-available annual selection, exact source lineage, deterministic recalculation, or an explicit typed gap.",
  "selection_rule": "Unless the ResearchCase explicitly fixes a historical period, select the latest issuer annual period publicly filed on or before as_of_date; never silently prefer same-fiscal-year comparability over freshness.",
  "claim_table_admission_rule": "Only base_fact_refs and derived_metric_refs emitted by this program, or typed_gap_refs emitted for an unavailable required slot, may enter downstream core Claims and tables.",
  "source_priority": [
    "current_targeted_capture_first_SEC_CompanyFacts_refresh",
    "current_latest_available_annual_gold_mart_exact_authority",
    "same_filing_comparative_instant_from_normalized_SEC_staging"
  ],
  "formula_contracts": {
    "gross_margin_percent": {"expression": "gross_profit/revenue*100", "required_inputs": ["gross_profit", "revenue"], "output_unit": "percent", "decimal_places": 4, "required_scope": "same_entity_annual_period_currency_unit"},
    "operating_margin_percent": {"expression": "operating_income/revenue*100", "required_inputs": ["operating_income", "revenue"], "output_unit": "percent", "decimal_places": 4, "required_scope": "same_entity_annual_period_currency_unit"},
    "free_cash_flow": {"expression": "operating_cash_flow-capital_expenditure_proxy", "required_inputs": ["operating_cash_flow", "capital_expenditure_proxy"], "output_unit": "USD", "decimal_places": 0, "required_scope": "same_entity_annual_period_currency_unit_and_positive_cash_outflow_capex"},
    "inventory_days": {"expression": "average(beginning_inventory,ending_inventory)/(revenue-gross_profit)*duration_days", "required_inputs": ["beginning_inventory", "ending_inventory", "revenue", "gross_profit"], "output_unit": "days", "decimal_places": 2, "required_scope": "same_entity_currency_unit_begin_end_inventory_and_exact_annual_duration"},
    "capital_intensity_percent": {"expression": "capital_expenditure_proxy/revenue*100", "required_inputs": ["capital_expenditure_proxy", "revenue"], "output_unit": "percent", "decimal_places": 4, "required_scope": "same_entity_annual_period_currency_unit_and_positive_cash_outflow_capex"}
    ,"accounts_receivable_change": {"expression": "ending_accounts_receivable-beginning_accounts_receivable", "required_inputs": ["ending_accounts_receivable", "beginning_accounts_receivable"], "output_unit": "USD", "decimal_places": 0, "required_scope": "same_entity_currency_unit_begin_end_balance_sheet_instants"}
    ,"accounts_payable_change": {"expression": "ending_accounts_payable-beginning_accounts_payable", "required_inputs": ["ending_accounts_payable", "beginning_accounts_payable"], "output_unit": "USD", "decimal_places": 0, "required_scope": "same_entity_currency_unit_begin_end_balance_sheet_instants"}
  },
