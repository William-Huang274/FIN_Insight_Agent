      "anchor_end": 189,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 0,
      "anchor_text": "C.C. Wei - Taiwan Semiconductor Manufacturing Co Ltd - Chairman and Chief Executive Officer\nWell, let me say that our packaging capacity is so tight that now it limits my customers' growth.",
      "case_key": "DELL",
