      "anchor_end": 209,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 0,
      "anchor_text": "Operating income increased $2.7 billion or 24%.\n•\nCost of revenue increased $4.8 billion or 47% driven by investments in AI infrastructure to support growing customer demand and increased GitHub Copilot usage.",
      "case_key": "MU",
      "evidence_item_digest": "9125cbfcd96bddee14ef47977bf919bc8988f961739cf6246ab11c06b5720903",
      "review_status": "reviewed_exact_source_surface",
      "source_record_id": "MSFT_2026_10Q_ITEM2_BLOCK_0004_PART_03_OF_04",
