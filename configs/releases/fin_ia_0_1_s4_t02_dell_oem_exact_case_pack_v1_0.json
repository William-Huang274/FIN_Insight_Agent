        "cannot_infer_customer_or_channel_concentration"
      ],
      "stop_rule": "Stop before a durable-demand judgment if no issuer or company-bound official signal and no independent counterindicator are both available.",
      "what_would_change_targets": [
        "weaker_company_specific_order_to_revenue_conversion",
        "material_channel_or_customer_inventory_accumulation",
        "order_cancellation_or_pull_forward_evidence",
        "official_deployment_or backlog evidence that contradicts the current boundary"
