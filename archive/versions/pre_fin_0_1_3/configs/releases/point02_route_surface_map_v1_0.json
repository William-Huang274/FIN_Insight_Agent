{
  "schema_version": "finsight_point02_route_surface_map_v1_0",
  "artifact_id": "point02-route-surface-map-v1-0",
  "point": "P02.0-T04",
  "api_prefix": "/api/v1",
  "refresh_rule": "URL_plus_canonical_current_head_must_restore_each_surface; React memory is not authoritative.",
  "shared_error_contract": [
    "validation_error",
    "version_conflict",
    "stale_or_superseded",
    "permission_denied",
    "not_found",
    "typed_gap",
    "operation_not_admitted"
  ],
  "surfaces": [
    {"route": "/cases", "feature": "Task Center", "read_models": ["TaskCenterProjection"], "actions": ["CreateCaseDraft"], "states": ["loading", "empty", "ready", "error"], "owner": "TECH_09", "browser_acceptance": "list, empty and typed error render without direct store access"},
    {"route": "/cases/new", "feature": "New Research Task", "read_models": ["CaseDraftFormProjection"], "actions": ["CreateCaseDraft"], "states": ["editing", "submitting", "validation_error"], "owner": "TECH_09", "browser_acceptance": "required query, as-of, language and source-policy errors are visible"},
    {"route": "/cases/:caseId/overview", "feature": "Case Overview / Plan", "read_models": ["CaseWorkspaceProjection"], "actions": ["UpdateCaseObjective", "CompileDecisionSurface", "AcceptPlanningCheckpoint", "ReturnPlanningCheckpoint"], "states": ["loading", "planning", "awaiting_review", "stale", "error"], "owner": "TECH_09", "browser_acceptance": "refresh restores exact case/current-head or shows typed stale state"},
    {"route": "/cases/:caseId/decision-surface", "feature": "Decision Surface", "read_models": ["DecisionSurfaceView"], "actions": ["AcceptPlanningCheckpoint", "ReturnPlanningCheckpoint"], "states": ["draft", "shadow", "awaiting_review", "typed_gap", "superseded"], "owner": "TECH_09", "browser_acceptance": "cell owner, slot and stop-rule visibility precedes any future execution action"},
    {"route": "/cases/:caseId/evidence", "feature": "Evidence & Numeric", "read_models": ["EvidenceWorkbenchView", "NumericAuditView"], "actions": ["RequestRepair", "RejectCandidate"], "states": ["not_admitted", "typed_gap", "context_only", "rejected"], "owner": "TECH_10", "browser_acceptance": "design fixture distinguishes non-citable fixture evidence from accepted evidence"},
    {"route": "/cases/:caseId/workpaper", "feature": "Workpaper & Repair", "read_models": ["WorkpaperView", "RepairQueueView"], "actions": ["CreateRepairTicket", "LeadReview"], "states": ["not_admitted", "awaiting_review", "typed_gap"], "owner": "TECH_10", "browser_acceptance": "future actions are disabled with an operation-not-admitted explanation"},
    {"route": "/cases/:caseId/deliverable", "feature": "Deliverable & Review", "read_models": ["DeliverableReviewView"], "actions": ["Comment", "Return", "AcceptDeliverable"], "states": ["not_admitted", "stale", "superseded", "permission_denied"], "owner": "TECH_10", "browser_acceptance": "exact version and review state are rendered; no Writer execution is implied"},
    {"route": "/cases/:caseId/activity", "feature": "Activity & Trace", "read_models": ["ActivityTraceView", "WorkUnitExecutionView"], "actions": ["CancelWorkUnit", "ResumeWorkUnit"], "states": ["pending", "running", "paused", "retryable_failed", "cancelled", "typed_gap"], "owner": "TECH_09", "browser_acceptance": "event order and typed stop are readable without exposing raw prompts or secrets"}
  ],
  "implementation_status": "route_and_acceptance_contract_only"
}
