      "with"
    ],
    "resource_use": "event_barrier_or_structural_premise_only_never_target_truth"
  },
  "resource_versions": {
    "abbreviation_policy": {
      "resource_id": "R14_abbreviation_boundary_exceptions_v1",
      "entries": [
        "Co.",
        "Corp.",
        "Inc.",
        "Ltd.",
        "No.",
        "U.K.",
        "U.S.",
        "e.g.",
        "i.e.",
        "vs."
