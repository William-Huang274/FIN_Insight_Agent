            "method_step_ref": "METHOD::SR::CONSTRAINT_CHAIN",
            "instruction_zh": "把晶圆、先进封装、HBM、系统集成、客户准备度和交付逐层拆开；一层扩产不能自动证明整条链约束解除。"
          },
          {
            "method_step_ref": "METHOD::SR::ALLOCATION_TIMING_YIELD",
            "instruction_zh": "没有 Dell 特定分配、时点、良率或利用率证据时，只能形成上游背景或有界 read-through。"
          },
          {
            "method_step_ref": "METHOD::SR::GRAPH_EVIDENCE_BOUNDARY",
            "instruction_zh": "Graph 只帮助发现关系和下一步查询；任何新增或修正边必须带 reviewed Evidence，不能靠模型记忆成为业务事实。"
          },
          {
            "method_step_ref": "METHOD::SR::MATERIAL_GAP_WWC",
            "instruction_zh": "只追问会改变交付与约束判断的分配、良率、时点和直接关系证据，并把改变条件写成可观察披露。"
          }
        ]
      }
