      "source_text_digest": "0fb9f788b2e84cc82eda20ce4b548d96d631eafda1bea6c9e8768a035dd94e3e",
      "target_id": "CURRENT_DOC::MU::8_K::0000723125_26_000013::ITEM_CURRENT_REPORT::BLOCK_0002::PART_02_OF_03::CLAIM::28C9FDE782F9"
    },
    {
      "anchor_digest": "10d58a3715cbec4d8fbb9932df1a1297ffd7ae6940630e9e3010b8e4baa27731",
      "anchor_end": 189,
      "anchor_kind": "structured_claim_text",
      "anchor_start": 0,
