# Copy to a Git-ignored .env or set these in the process environment.
# Never commit credential values.

# Local Agent Server credentials and database roles.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=fin-insight-dell-reference-vertical
# Model credentials; research is initiated explicitly in the workbench.
DEEPSEEK_API_KEY=
FINSIGHT_AGENT_SERVER_POSTGRES_PASSWORD=
FINSIGHT_AGENT_SERVER_HOST_PORT=18123
FINSIGHT_LANGGRAPH_POSTGRES_PASSWORD=
FINSIGHT_FIN_RUNTIME_POSTGRES_PASSWORD=
FINSIGHT_FIN_RUNTIME_OPERATOR_POSTGRES_PASSWORD=

# Your host data locations. Required only for the reference data composition.
# Historical environment variable names remain compatible with existing services.
# No dataset or previous developer permission is shipped with the application.
FINSIGHT_RESEARCH_RESOURCES_HOST_ROOT=
FINSIGHT_DELL_S1_NODES_HOST_PATH=
FINSIGHT_DELL_REVIEWED_BASE_PACK_HOST_PATH=
FINSIGHT_DELL_REVIEWED_OVERLAY_HOST_PATH=
FINSIGHT_DELL_S2_RESULT_HOST_PATH=
FINSIGHT_DELL_S2_MART_HOST_PATH=
FINSIGHT_DELL_EXTERNAL_PACK_HOST_ROOT=

# Optional resource package for the local historical-data API.
FINSIGHT_RESEARCH_RESOURCES_ROOT=

# Explicit private-data boundary. Relative paths resolve from the repository.
FINSIGHT_DATA_ROOT=data
# Immutable reviewed Evidence objects; may be mounted read-only.
FINSIGHT_REVIEWED_EVIDENCE_ROOT=data/workbench_private
# Mutable Operations SQLite and job state; must be a separate writable mount in containers.
FINSIGHT_WORKBENCH_PRIVATE_ROOT=data/workbench_private
FINSIGHT_OBJECT_STORE_ROOT=data/object_store
FINSIGHT_SECONDARY_DATA_ROOTS=

# SEC requires an identifiable contact for automated clients.
SEC_USER_AGENT=FinSight-Agent/0.1.3 contact@example.com

# Optional external-data credentials. Leave blank when the provider is unused.
FMP_API_KEY=
EIA_API_KEY=

# Optional semantic supplement; disabled/unbound in the current baseline.
FINSIGHT_MILVUS_MODE=unbound_cloud_deferred
FINSIGHT_MILVUS_RUNTIME_CONFIG=

# Workbench process limits.
WORKBENCH_MAX_ACTIVE_JOBS=2
WORKBENCH_DEFAULT_TIMEOUT_S=900
WORKBENCH_CANCEL_GRACE_S=5
